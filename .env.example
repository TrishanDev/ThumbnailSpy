PORT=3000
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Dodo Payments Configuration
DODO_PAYMENTS_API_KEY=dodo_sk_test_xxxxxx
DODO_PAYMENTS_MODE=test
# Copy the Webhook Secret from Dodo Dashboard > Webhooks > (your endpoint) > Signing Secret
DODO_WEBHOOK_SECRET=whsec_xxxxxx
DODO_PRODUCT_ID_LIFETIME=pdt_xxxxxx1
DODO_PRODUCT_ID_PRO=pdt_xxxxxx2

# Firebase Admin SDK (required for webhook to write to Firestore securely)
# Get from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON as a single line (minified)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
